# 复制为 .env 可覆盖默认值；docker compose 会自动读取当前目录的 .env

# 数据库（默认值与 docker-compose.yml 中的 postgres 服务一致）
DATABASE_URL=postgresql://webhook:webhook@db:5432/webhooks

# Worker 抢占租约时长（秒）。HTTP 超时必须小于租约，否则可能被其他 Worker 接管
LEASE_SECONDS=30
HTTP_TIMEOUT_SECONDS=10
WORKER_POLL_SECONDS=1

# 投递策略：最多尝试 6 次，失败按 base * 2^(n-1) 指数退避
# （这是全局默认值；新建订阅的初始配置版本可单独覆盖，见 README“配置版本”）
MAX_ATTEMPTS=6
BACKOFF_BASE_SECONDS=5
BACKOFF_CAP_SECONDS=300

# 本地回调接收器签名校验密钥；留空则只记录签名不强制校验
RECEIVER_SECRET=dev-signing-secret
RECEIVER_TIMESTAMP_TOLERANCE_SECONDS=300

# ---- Webhook 出站目标安全策略（SSRF 防护）----
# 默认阻止：回环(127/8,::1)、链路本地(169.254/16,fe80::/10)、私网
# (10/8,172.16/12,192.168/16,fc00::/7)、组播、保留/未指定地址，
# 以及云元数据地址(169.254.169.254,fd00:ec2::254,metadata.google.internal)。
# 创建订阅/发布配置版本时只接受 http/https 且禁止带用户名密码的 URL；
# Worker 每次尝试重新解析并固定校验通过的地址（防 DNS 重绑定），
# 重定向每一跳都按同一规则校验。
#
# 精确主机名白名单（逗号分隔，大小写不敏感）：命中后该主机的全部解析地址放行。
# docker compose 默认已在 compose 文件内置 receiver；本地裸机联调（目标为
# 127.0.0.1）可追加：receiver,127.0.0.1,localhost
WEBHOOK_ALLOWED_HOSTS=receiver
# CIDR/IP 白名单（逗号分隔）：例如 172.16.0.0/12,10.0.0.5
# 地址落入即放行，即使它属于默认阻止类别（放行优先）。
WEBHOOK_ALLOWED_CIDRS=
# Worker 跟随重定向的最大跳数（每跳重新做结构与地址校验）
WEBHOOK_MAX_REDIRECTS=5

# ---- 订阅 HMAC 密钥信封加密（本地密钥环）----
# 每个配置版本的密钥用随机 DEK 经 AES-256-GCM 加密（AAD 绑定订阅与版本），
# DEK 再由本地密钥环的主密钥包裹；数据库只存密文，主密钥不落库。
#
# 优先级：WEBHOOK_KEYRING_JSON（非空时）> WEBHOOK_KEYRING_FILE。
# docker compose 默认挂载 ./deploy/dev-keyring.json（仅供本地开发，生产必须更换）。
# 生成新密钥：python -m app.keyadmin generate-key
# 格式：{"active_key_id":"k1","keys":{"k1":"<base64 编码的 32 字节密钥>"}}
WEBHOOK_KEYRING_JSON=
# WEBHOOK_KEYRING_FILE=/path/to/keyring.json
# compose 挂载的宿主机密钥环文件（默认 ./deploy/dev-keyring.json）
# WEBHOOK_KEYRING_HOST_FILE=./deploy/dev-keyring.json

# ---- 事件载荷对象存储（S3 兼容；compose 内为本地 MinIO）----
# 载荷按规范化 JSON 的 SHA-256 内容寻址存为不可变对象，相同载荷全局去重；
# 数据库 events 只存内容地址引用（迁移期保留 JSONB 双读/双写副本）。
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=webhook-payloads
# MinIO 等自建端点必须 path-style=true；指向 AWS 时可设 false
S3_FORCE_PATH_STYLE=true
# MinIO 宿主机映射端口（S3 API / Web 控制台 http://localhost:9001）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 垃圾回收宽限期（秒）：超过该时长仍无引用的废弃上传/孤儿对象才允许删除
PAYLOAD_GC_GRACE_SECONDS=86400
